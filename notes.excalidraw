      "updated": 1779791426993,
      "link": null,
      "locked": false,
      "text": "Method                       Use                                       Example\nadd()                     Add one element                            my_set.add(4)\nupdate()                 Add multiple elements                      my_set.update([4,5])\nremove()                 Remove element (error if missing)       my_set.remove(2)\ndiscard()                Remove element (no error if missing)    my_set.discard(10)\npop()                     Remove random element                    my_set.pop()\nclear()                    Remove all elements                         my_set.clear()\ncopy()                    Create copy of set                          new_set = my_set.copy()",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Method                       Use                                       Example\nadd()                     Add one element                            my_set.add(4)\nupdate()                 Add multiple elements                      my_set.update([4,5])\nremove()                 Remove element (error if missing)       my_set.remove(2)\ndiscard()                Remove element (no error if missing)    my_set.discard(10)\npop()                     Remove random element                    my_set.pop()\nclear()                    Remove all elements                         my_set.clear()\ncopy()                    Create copy of set                          new_set = my_set.copy()",
      "autoResize": true,
      "lineHeight": 1.25
    },
